[Unit]
Requires=sonarqube-prometheus.service
After=sonarqube-prometheus.service

[Container]
EnvironmentFile=/home/tpasch/scm/aanno/github/SonarQubeCompose/.env
Image=docker.io/grafana/grafana-oss:latest
Network=sonarqube
Pod=sonarqube.pod
Volume=grafana:/var/lib/grafana
Volume=/home/tpasch/scm/aanno/github/SonarQubeCompose/export:/export:z

[Service]
Restart=always
