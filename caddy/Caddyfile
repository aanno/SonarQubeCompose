{
    auto_https off
}

{$SONAR_METRICS_HOST:sonarqube-metrics.localhost}:{$CADDY_HTTP_PORT} {

    @sonarMetrics {
        path /api/monitoring/metrics
    }

    reverse_proxy @sonarMetrics http://{$SONAR_BACKEND_HOST:host.docker.internal}:9000 {
        header_up X-Sonar-Passcode "{$SONAR_WEB_SYSTEMPASSCODE}"
    }
}

localhost:80 {
    # tls internal
    
    # SonarQube
    handle /sonarqube/* {
        # uri strip_prefix /sonarqube
        reverse_proxy sonarqube:9000
    }
    
    # Prometheus  
    handle /prometheus/* {
        # uri strip_prefix /prometheus
        reverse_proxy prometheus:9090
    }
    
    # Grafana
    handle /grafana/* {
        reverse_proxy grafana:3000
    }
}
