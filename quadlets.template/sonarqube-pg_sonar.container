[Unit]
Requires=podman-exporter.service
After=podman-exporter.service

[Container]
HostName=pg_sonar
EnvironmentFile=$HOME/.config/SonarQubeCompose/.env
HealthCmd=pg_isready -U "$POSTGRES_USER" -d "$POSTGRES_DB"
HealthInterval=10s
HealthRetries=5
HealthTimeout=5s
Image=docker.io/library/postgres:18
Network=pg_sonar

# Pod=sonarqube.pod
# no PublishPort

Volume=pg_sonar:/var/lib/postgresql
Volume=$GIT_ROOT/export:/export:z

[Service]
Restart=always
# Restart=no
# RestartSec=3
